# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- Supabase (required once the app moves off local SQLite) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pooled connection (port 6543) for the app; direct (5432) for migrations.
DATABASE_URL=
DIRECT_URL=

# --- WhatsApp Business provider (optional) ---
# Leave unset in development: chases are composed and recorded locally
# instead of being delivered. See src/lib/whatsapp.ts.
# WA_PROVIDER=aisensy
# WA_API_KEY=

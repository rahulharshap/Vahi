# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# Full walkthrough: SETUP.md

# ---------------------------------------------------------------------------
# DATABASE_URL — the only credential the app needs.
#
# Supabase dashboard -> Connect -> Connection string -> Transaction pooler.
# Must be the POOLER (port 6543), not the direct connection (port 5432):
# direct connections exhaust the limit under serverless and are IPv6-only on
# newer projects.
#
# Put the password in bare, between the ':' and the '@'. Do not leave the
# [] or <> placeholder brackets in. If the password contains @ : / # ? %,
# percent-encode it (@ -> %40, # -> %23) or use an alphanumeric password.
#
# Leave DATABASE_URL unset entirely to run on local SQLite with no setup.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# SEED_TOKEN — shared secret guarding POST /api/seed, which wipes and rewrites
# every table. Seeding is disabled entirely when this is unset.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ---------------------------------------------------------------------------
SEED_TOKEN=

# ---------------------------------------------------------------------------
# WhatsApp Business provider — optional.
#
# Unset (the default): chase messages are composed and recorded locally but
# not delivered, so the whole pipeline is exercisable without a BSP account.
# To go live you need a provider account, approved message templates, and an
# adapter written in src/lib/whatsapp.ts.
# ---------------------------------------------------------------------------
# WA_PROVIDER=aisensy
# WA_API_KEY=

# Postgres pool size per serverless instance. Default 5; lower it if you hit
# Supabase connection limits under load.
# PG_POOL_MAX=5

# Set to false to hide the demo explainer banner once this holds real data.
# NEXT_PUBLIC_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Document intake.
#
# INTAKE_DOMAIN is the subdomain carrying the MX record. Every chase email uses
# a Reply-To of docs+<signed filing token>@<INTAKE_DOMAIN>, so a reply with
# attachments routes itself to the right filing with no guessing.
#
# INTAKE_SECRET signs those tokens. INBOUND_TOKEN guards POST /api/inbound/email
# and intake is disabled entirely when it is unset.
# Generate both: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ---------------------------------------------------------------------------
INTAKE_DOMAIN=in.example.com
INTAKE_SECRET=
INBOUND_TOKEN=

# Email delivery provider. Unset means chases are composed and recorded but
# not sent, same as WA_PROVIDER.
# EMAIL_PROVIDER=postmark
# EMAIL_API_KEY=

# ---------------------------------------------------------------------------
# Authentication (Supabase Auth).
#
# Both values are public: the URL is a hostname, and the publishable key is
# designed to ship to browsers. RLS and the revokes in 0002/0005 mean it can
# read nothing on its own. Supabase dashboard -> Project Settings -> API.
#
# Leave BOTH unset to run with authentication off — the app then behaves as a
# single open tenant, which is fine for a demo with sample data and not fine
# for a real client list.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated emails that may reach the platform console at /admin.
# This exists to solve the bootstrap: the first operator cannot be granted
# through a page only operators can open. It belongs in the host environment,
# never in the database.
PLATFORM_ADMIN_EMAILS=

# Read-only guest mode. Set to 1 and anyone with the link can look around
# without signing in, and cannot change anything — every mutating server
# action refuses. Meant for sharing a demo for feedback, which is otherwise
# done by sharing one login: a password to leak, no idea who looked, and a
# visitor who can delete the demo for everyone else.
#
# NEVER enable this on a deployment holding a real client list.
# DEMO_GUEST=1
